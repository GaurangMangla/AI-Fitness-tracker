# Copy this file to .env and fill in real values for local development.
# Production values go in the deployment platform's environment variables UI
# (Render / Railway / Fly.io) — never commit a real .env file.

# ── General ────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (local dev — no setup required):
DATABASE_URL=sqlite:///./athlyt.db

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/athlyt
#
# For managed providers:
# Render:   postgresql+psycopg2://user:pass@dpg-xxx.oregon-postgres.render.com/athlyt
# Railway:  postgresql+psycopg2://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
# Supabase: postgresql+psycopg2://postgres:pass@db.xxxx.supabase.co:5432/postgres
#
# Neon requires `sslmode=require` in the connection string (Neon rejects
# unencrypted connections outright) — append it as a query parameter:
# Neon:     postgresql+psycopg2://user:pass@ep-xxx.us-east-2.aws.neon.tech/athlyt?sslmode=require

# ── Auth / JWT ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-value-before-running

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel URL, no trailing slash):
# CORS_ORIGINS=https://athlyt.vercel.app,https://your-custom-domain.com

# ── Allowed Hosts ─────────────────────────────────────────────────────────
# Hostnames this API accepts requests for, checked against the Host header.
# "*" (any host) is fine for local dev — production should list only the
# real API domain to prevent Host header injection attacks.
# Local dev:
ALLOWED_HOSTS=*
# Production:
# ALLOWED_HOSTS=athlyt-api.onrender.com

# ── Machine Learning ──────────────────────────────────────────────────────
# Which recommendation engine serves POST /workouts/recommend:
#   ml   — the trained model (default). Falls back to the rule engine
#          automatically on any failure or low-confidence prediction —
#          see docs/ML_INTEGRATION.md and ml/models/PRODUCTION_ROLLOUT.md.
#   rule — the original rule-based engine only, no ML involved at all.
#          Set this for an instant rollback with zero code changes.
RECOMMENDATION_ENGINE=ml

# Paths to the trained model artifacts, relative to backend/'s working
# directory. Tracked via Git LFS — run `git lfs install && git lfs pull`
# before relying on the ML engine; without it these paths point at small
# LFS pointer files, not the real model (handled gracefully — see
# docs/ML_INTEGRATION.md §3.1 — but ML predictions won't work until pulled).
ML_MODEL_PATH=../ml/models/model.joblib
ML_PREPROCESSOR_PATH=../ml/models/preprocessor.joblib

# Below this predict_proba() confidence, the ML engine defers to the rule
# engine instead of using an uncertain prediction. See
# ml/models/PRODUCTION_ROLLOUT.md §4 for how this value was validated.
ML_CONFIDENCE_THRESHOLD=0.6
